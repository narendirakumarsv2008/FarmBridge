# ---------------------------------------------------------
# FarmBridge configuration — copy to .env / Render secrets.
# NEVER commit the real .env file. Never include real credentials.
# ---------------------------------------------------------

# Application
ENVIRONMENT=development            # development | test | production
FLASK_ENV=development
FLASK_DEBUG=false
# Public base URL used in future notifications/links.
APP_BASE_URL=http://localhost:5000
SECRET_KEY=replace_with_secure_random_secret
JWT_EXPIRES_HOURS=72

# Database
DB_ENGINE=mysql                    # mysql | sqlite
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=farmbridge
MYSQL_PASSWORD=your_password
MYSQL_DB=farmbridge
# disabled | preferred | require | verify-ca | verify-identity
# Most managed providers accept 'preferred' or 'require'. If the DB provides a
# CA cert bundle, set it to 'verify-ca' and provide MYSQL_SSL_CA.
MYSQL_SSL_MODE=preferred
# Optional CA file for verify-ca / verify-identity.
MYSQL_SSL_CA=
# Only needed when the MySQL user has privileges to CREATE DATABASE
# (e.g. local Docker MySQL). Managed cloud DBs usually already create the DB.
MYSQL_CREATE_DATABASE=false
MYSQL_CONNECT_TIMEOUT=10
# SQLite path (used when DB_ENGINE=sqlite, dev/tests only)
SQLITE_PATH=farmbridge.db

# Storage
# local = default. Cloud render/uploads are NOT persistent across redeploys.
# cloudinary = optional persistent cloud storage (recommended for production).
STORAGE_PROVIDER=local
UPLOAD_FOLDER=uploads
MAX_UPLOAD_SIZE_MB=5

# Optional Cloudinary (only used when STORAGE_PROVIDER=cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Auth / OTP
SMS_PROVIDER=mock                # mock for demo; production-ready for SMS
MOCK_OTP=123456
OTP_EXPIRY_MINUTES=5

# Ordering / marketplace
DELIVERY_FEE=25
FREE_DELIVERY_ABOVE=500
MARKET_REFRESH_SECONDS=30
MARKET_PAGE_SIZE=100

# CORS. In production set this to the exact frontend origin(s), e.g.
# ALLOWED_ORIGINS=https://farmbridge.onrender.com
# Do not use '*' for sensitive authenticated production APIs.
ALLOWED_ORIGINS=*
# Legacy alias kept for backward compatibility.
CORS_ORIGINS=*

# Gunicorn
GUNICORN_WORKERS=1
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=60
