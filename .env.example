# ---------------------------------------------------------
# FarmBridge environment configuration
# Copy to .env (or set in your deployment platform's secrets)
# and NEVER commit the real .env file.
# ---------------------------------------------------------

# development | test | production
ENVIRONMENT=development
FLASK_ENV=development
FLASK_DEBUG=false

# Required in production. Use a long random string.
SECRET_KEY=change-this-in-production

# Database engine: mysql (production) or sqlite (local dev/test)
DB_ENGINE=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=farmbridge
MYSQL_PASSWORD=change-me
MYSQL_DB=farmbridge

# SQLite path (used when DB_ENGINE=sqlite, dev/tests only)
SQLITE_PATH=farmbridge.db

# Uploads
UPLOAD_FOLDER=uploads
MAX_UPLOAD_SIZE_MB=5

# Auth / OTP
# mock = demo OTP returned in development; production should point to an SMS
# provider implementation.
SMS_PROVIDER=mock
MOCK_OTP=123456
OTP_EXPIRY_MINUTES=5
JWT_EXPIRES_HOURS=72

# CORS in production: comma-separated allowed origins, e.g. https://app.example.com
CORS_ORIGINS=*
