# FarmBridge database configuration
#
# Farmer listings and all buyer records are stored here. Point these at your
# MySQL server and the Buyer Portal will load its catalogue from MySQL.
#
# If MySQL is unreachable the app automatically falls back to a local SQLite
# file (farmbridge.db) so development never blocks.

DB_ENGINE=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=farmbridge
MYSQL_PASSWORD=change-me
MYSQL_DB=farmbridge
