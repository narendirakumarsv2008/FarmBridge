# ============================================================
# FARM BRIDGE — environment configuration
#
# Copy this file to `.env` and adjust the values. NEVER commit
# `.env` (it is git-ignored and may contain real secrets).
# ============================================================

# Runtime environment: development | production
#   development → SQLite fallback allowed, debug on, mock OTP
#   production  → MySQL required (fails loudly if unreachable), Gunicorn
ENVIRONMENT=development

# Secret key used to sign auth tokens. CHANGE THIS in production.
SECRET_KEY=change-this-in-production

# ------------------------------------------------------------------
# Database
# ------------------------------------------------------------------
# Engine: mysql | sqlite
DB_ENGINE=mysql

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=farmbridge
MYSQL_PASSWORD=change-me
MYSQL_DB=farmbridge

# Startup resilience: how many times (and how far apart, in seconds) to retry
# the MySQL connection before giving up. Useful on platforms where the database
# starts in parallel with the app (e.g. Render, Docker Compose).
MYSQL_CONNECT_RETRIES=10
MYSQL_CONNECT_RETRY_DELAY=3

# SQLite file location (development/testing only)
# SQLITE_PATH=farmbridge.db

# ------------------------------------------------------------------
# Uploads
# ------------------------------------------------------------------
# Directory where uploaded crop images are stored (local dev).
# Production can point this at an object store via a custom provider.
UPLOAD_FOLDER=uploads

# Max total request body (bytes) — guards against huge uploads.
MAX_CONTENT_LENGTH=8388608
# Max single image size (bytes).
MAX_IMAGE_BYTES=5242880

# ------------------------------------------------------------------
# Authentication
# ------------------------------------------------------------------
# Lifetime of a signed token (seconds). Default 7 days.
TOKEN_TTL_SECONDS=604800
# OTP validity window (seconds).
OTP_TTL_SECONDS=300
# Development-only mock OTP (ignored in production).
MOCK_OTP=123456
# Production SMS provider hook, e.g. "yourapp.sms:send_otp"
# (a callable fn(phone, otp) → None). Leave empty in development.
# SMS_PROVIDER=

# ------------------------------------------------------------------
# Ordering
# ------------------------------------------------------------------
DEFAULT_DELIVERY_FEE=25
FREE_DELIVERY_ABOVE=500
